# Configuración de la aplicación
APP_NAME=Bookstore Inventory API
APP_VERSION=1.0.0
DEBUG=true

# Base de datos (PostgreSQL)
#
# Debe usar el driver async: el esquema es `postgresql+asyncpg://`, no
# `postgresql://` (que es el que copian por defecto la mayoría de paneles).
#
# En local con docker-compose:
#   postgresql+asyncpg://postgres:postgres@db:5432/bookstore
#
# En Supabase, usar el Transaction Pooler (puerto 6543), no la conexión
# directa: el plan gratuito limita mucho las conexiones directas.
#   postgresql+asyncpg://postgres.<ref>:<password>@<host>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/bookstore

# API externa de tasas de cambio
EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_API_TIMEOUT=5

# Reglas de negocio
DEFAULT_MARGIN_PERCENTAGE=40
# Tasa por defecto que se usa cuando la API externa falla (USD -> EUR aprox.)
DEFAULT_FALLBACK_RATE=0.92
DEFAULT_FALLBACK_CURRENCY=EUR
